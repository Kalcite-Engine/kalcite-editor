// Editor viewport policy compiled from Kalcite itself. Values use milli-pixels
// so the Rust UI adapter retains fractional drag precision without owning the
// snap decision.
public i32 editor_snap_milli(i32 value, bool enabled) {
    if !enabled { return value; }
    i32 step = 8000;
    i32 half = 4000;
    if value >= 0 { return ((value + half) / step) * step; }
    return ((value - half) / step) * step;
}

// Collision-shape sizing follows the same fixed-point boundary. The host
// supplies milli-pixels; KLC chooses the max axis and enforces a 1px minimum.
public i32 editor_circle_radius_milli(i32 width, i32 height) {
    i32 absolute_width = width;
    i32 absolute_height = height;
    if absolute_width < 0 { absolute_width = 0 - absolute_width; }
    if absolute_height < 0 { absolute_height = 0 - absolute_height; }
    i32 largest = absolute_width;
    if absolute_height > largest { largest = absolute_height; }
    i32 radius = largest / 2;
    if radius < 1000 { return 1000; }
    return radius;
}

// Grid density is editor policy too: zoomed-out scenes remain readable while
// zoomed-in scenes retain useful placement precision. The returned value is a
// logical-world spacing in milli-pixels.
public i32 editor_grid_step_milli(i32 zoom_milli) {
    if zoom_milli < 750 { return 32000; }
    if zoom_milli > 2000 { return 8000; }
    return 16000;
}

// Tile colours are editor presentation policy. RGB is packed as 0xRRGGBB so
// the Rust adapter merely converts it to the native UI colour type.
public u32 editor_tile_color_rgb(u32 tile) {
    u32 index = tile % 8;
    if index == 0 { return 3225414; }
    if index == 1 { return 5544673; }
    if index == 2 { return 6603389; }
    if index == 3 { return 15708493; }
    if index == 4 { return 13790575; }
    if index == 5 { return 10450911; }
    if index == 6 { return 5948096; }
    return 11184810;
}

// Scene-node palette selection is editor policy. The native shell maps a
// dynamic scene type to a small stable category and renders this RGB value.
// category: 0=generic, 1=collision, 2=control, 3=sprite.
public u32 editor_node_color_rgb(u32 category, bool selected) {
    if selected { return 16776960; }
    if category == 1 { return 15692402; }
    if category == 2 { return 8841388; }
    return 8896255;
}

// Default scene-node geometry is editor policy too. Sprites begin at a
// compact 24px square while all other nodes retain the 48px-wide default.
// The native host maps dynamic type names to these stable categories and only
// converts the resulting KLC dimensions to egui coordinates.
public i32 editor_node_default_width(u32 category) {
    if category == 3 { return 24; }
    return 48;
}

public i32 editor_node_default_height() {
    return 24;
}

// New scene nodes without an explicit transform start inside the native
// 320×240 design frame. Keeping the origin in KLC makes hit testing, dragging,
// and painting agree on the same deterministic fallback.
public i32 editor_node_default_x() {
    return 32;
}

public i32 editor_node_default_y() {
    return 32;
}

// Returns -1 when a candidate is not in the requested direction; otherwise
// returns a deterministic primary-axis weighted distance for gamepad focus.
// direction: 0=up, 1=down, 2=left, 3=right.
public i32 editor_navigation_score(i32 from_x, i32 from_y, i32 candidate_x, i32 candidate_y, i32 direction) {
    if direction == 0 {
        if candidate_y >= from_y { return -1; }
        i32 secondary = from_x - candidate_x;
        if secondary < 0 { secondary = 0 - secondary; }
        return (from_y - candidate_y) * 1000 + secondary;
    } else if direction == 1 {
        if candidate_y <= from_y { return -1; }
        i32 secondary = from_x - candidate_x;
        if secondary < 0 { secondary = 0 - secondary; }
        return (candidate_y - from_y) * 1000 + secondary;
    } else if direction == 2 {
        if candidate_x >= from_x { return -1; }
        i32 secondary = from_y - candidate_y;
        if secondary < 0 { secondary = 0 - secondary; }
        return (from_x - candidate_x) * 1000 + secondary;
    } else {
        if candidate_x <= from_x { return -1; }
        i32 secondary = from_y - candidate_y;
        if secondary < 0 { secondary = 0 - secondary; }
        return (candidate_x - from_x) * 1000 + secondary;
    }
}

// Static editor profiling is deterministic policy. Rust inventories scene
// nodes and assets, while KLC owns the estimated work model shown to authors.
public u32 editor_profile_update_us(u32 collisions, u32 fluids) {
    return 220 + collisions * 35 + fluids * 8;
}

public u32 editor_profile_render_us(u32 sprites, u32 tilemaps, u32 raytracers) {
    u32 tiles = tilemaps * 64;
    return 300 + sprites * 55 + tiles * 2 + raytracers * 8000;
}

public u32 editor_profile_physics_us(u32 collisions, u32 fluids) {
    return collisions * 60 + fluids * 25;
}

// Profiler thresholds are product policy, not widget policy. Metric 0 is the
// full frame budget at 60 Hz; all secondary metrics use the diagnostic budget.
public u32 editor_profile_limit_us(u32 metric) {
    if metric == 0 { return 16667; }
    return 20000;
}

// Budget levels are data policy, not toolkit policy. 0=safe, 1=warning,
// 2=over budget; the Rust shell only selects the native UI colour.
public u32 editor_budget_level(u32 value, u32 limit) {
    if value < limit * 3 / 5 { return 0; }
    if value < limit { return 1; }
    return 2;
}

// Native UI shells choose their own colour type, while KLC owns the semantic
// mapping of a budget level to the shared editor palette.
public u32 editor_budget_color_rgb(u32 level) {
    if level == 0 { return 9498256; }
    if level == 1 { return 16754253; }
    return 16737380;
}

public u32 editor_resource_budget_level(u32 bytes, bool target_numworks) {
    if target_numworks && bytes > 24000 { return 2; }
    return 0;
}

// Resize constraints share the same fixed-point snap behavior as positions.
// Dimensions never collapse to zero even when a dragged edge crosses its
// origin. The UI host only converts between pixels and milli-pixels.
public i32 editor_dimension_milli(i32 value, bool snap) {
    i32 adjusted = editor_snap_milli(value, snap);
    if adjusted < 1000 { return 1000; }
    return adjusted;
}

public u32 editor_fluid_budget_level(u32 particles, bool target_numworks) {
    if target_numworks && particles > 128 { return 2; }
    return 0;
}
